# ============================================================
#  Prospector — configuração
#  Copie este arquivo para ".env" e preencha. O ".env" tem a sua
#  chave secreta: nunca envie para o GitHub nem cole em conversas.
# ============================================================

# --- AIsa (https://aisa.one) ---------------------------------
# Uma única chave serve para o Google Maps (via DataForSEO) e para o LLM.
AISA_API_KEY=cole-sua-chave-aqui
AISA_BASE_URL=https://api.aisa.one
# Modelo usado para escrever a proposta. Veja os disponíveis em
# https://aisa.one/docs/guides/models  (gpt-4.1 é o exemplo da documentação)
AISA_MODEL=gpt-4.1

# --- Onde buscar (público de Bragança Paulista/SP) -----------
CITY_NAME=Bragança Paulista
# Centro da busca no formato "latitude,longitude,zoom". O zoom controla o raio
# (13z ≈ cidade toda; 15z ≈ um bairro). Para outro bairro: no Google Maps, clique
# com o botão direito no ponto e copie as coordenadas.
LOCATION_COORDINATE=-22.9527,-46.5419,13z
SEARCH_LANGUAGE=pt
# Quantos resultados pedir por categoria. Quanto maior, mais caro.
SEARCH_DEPTH=40
# Categorias pesquisadas quando você não usa --categoria (separe por vírgula)
CATEGORIES=padaria,barbearia,salão de beleza,pet shop,restaurante,oficina mecânica,academia,loja de roupas

# --- Filtros de qualidade ------------------------------------
MIN_RATING=4.5
# Evita "nota 5,0 com 2 avaliações"
MIN_REVIEWS=10

# --- Dados da SUA empresa (aparecem na proposta) -------------
COMPANY_NAME=Sua Consultoria
COMPANY_CONTACT=WhatsApp (11) 90000-0000 | contato@suaempresa.com.br

# --- Investimento e prazo (valores fixos, o LLM não mexe neles) --
PRICE_TOTAL=2500
INSTALLMENTS=3
DELIVERY_DAYS=15
PROPOSAL_VALIDITY_DAYS=7

# --- Saída ---------------------------------------------------
OUTPUT_DIR=output

# ============================================================
#  APP WEB (python -m webapp) — só necessário se for usar a versão web
# ============================================================

# "firebase" = exige login (use SEMPRE que o app estiver na internet).
# "none"     = sem login; o servidor só aceita conexões do próprio computador.
AUTH_MODE=firebase

# Login: os mesmos dados do Firebase do app de pesquisa (arquivo
# pesquisademercado/js/firebase-config.js). Não são segredos.
FIREBASE_PROJECT_ID=pesquisa-de-mercado-c87b1
FIREBASE_WEB_API_KEY=cole-o-apiKey-do-firebase-config
FIREBASE_APP_ID=cole-o-appId-do-firebase-config

# E-mails que podem usar o app, separados por vírgula. Sem esta lista o servidor não sobe:
# ela impede que qualquer pessoa gaste os créditos da sua AIsa.
ALLOWED_EMAILS=socio1@exemplo.com,socio2@exemplo.com,socio3@exemplo.com

# Limites de custo aplicados no servidor (valem mesmo que alguém mexa na página)
MAX_CATEGORIES=8
MAX_DEPTH=100
MAX_PROPOSALS=15

# Rede: em hospedagem/Docker use HOST=0.0.0.0 (a plataforma costuma definir PORT sozinha).
# Localmente, deixe como está.
HOST=127.0.0.1
PORT=8000
